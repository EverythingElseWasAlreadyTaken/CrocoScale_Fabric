# NPU_ACCUM_N subtile: 3 BEL inputs (BASE_TO_TOP), 0 BEL outputs (TOP_TO_BASE).

# BEL inputs: WDATA on the quads by depth (LSB 4 rows deep),
# ADDR, WE, READ_BANK_SEL on ends launched 1-2 rows below.
{4}BASE_TO_TOP0,[N1END0|N2MID0|N2END7|N2MID7]
