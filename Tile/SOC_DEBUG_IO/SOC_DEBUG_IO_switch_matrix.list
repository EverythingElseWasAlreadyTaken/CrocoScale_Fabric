# SOC_DEBUG_IO: S_IO wires, SOC_DEBUG_CTRL_BEL instead of the IO BEL.
# Border-row tile with config bits (needs IncludeBorderRows, auto-detected).

# BEL inputs: 4:1 over wire ends launched 1-2 rows up, indices twisted.
{4}FAB_DEBUG_IN0,[S2MID0|S2END7|S4END8|SS4END8]
{4}FAB_DEBUG_IN1,[S2MID1|S2END6|S4END9|SS4END9]
{4}FAB_DEBUG_IN2,[S2MID2|S2END5|S4END10|SS4END10]
{4}FAB_DEBUG_IN3,[S2MID3|S2END4|S4END11|SS4END11]
