{4}FAB_DEBUG_IN5,[S2MID5|S2END2|S4END13|SS4END13]
{4}FAB_DEBUG_IN6,[S2MID6|S2END1|S4END14|SS4END14]
{4}FAB_DEBUG_IN7,[S2MID7|S2END0|S4END15|SS4END15]
{4}FAB_USR_IRQ,[S1END0|S1END1|S4END4|SS4END4]

# North wires: turnaround (sends a wire back to the row it came from),
# a BEL output, and two other wire ends so a signal can switch channel.
{4}N4BEG0,[S4END15|FAB_DEBUG_OUT0|SS4END0|S2MID0]
